# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "banking-provider's Provider.S implemented over the Lightspark Grid API"
description:
  "Adapter from the provider-neutral banking-provider interface to lightspark-client's Grid API: customers, USD and stablecoin accounts, cross-border payouts to bank accounts and wallets with FX quotes, conversions between a customer's own accounts, sandbox funding and webhooks normalized into banking-provider events. Sandbox by default."
maintainer: ["hello@winterchill.xyz"]
authors: ["WinterChill AI"]
license: "MIT"
tags: ["banking" "payments" "fx" "async"]
homepage: "https://github.com/winterchill-trading/lightspark-provider"
doc: "https://github.com/winterchill-trading/lightspark-provider#readme"
bug-reports:
  "https://github.com/winterchill-trading/lightspark-provider/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "async_kernel"
  "ppx_jane"
  "ppx_yojson_conv"
  "yojson"
  "uri"
  "zarith"
  "money"
  "ledger"
  "kyc-core"
  "payments-core"
  "card-core"
  "banking-provider"
  "lightspark-client"
  "expect_test_helpers_core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo:
  "git+https://github.com/winterchill-trading/lightspark-provider.git"
